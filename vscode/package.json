{
  "name": "pirate-vscode",
  "displayName": "Pi-rate",
  "description": "Use Pi-rate as a native ACP coding agent in VS Code.",
  "version": "0.4.0",
  "publisher": "spa-skyson",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Themes"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onChatSession:pirate",
    "onLanguageModelChatProvider:pirate",
    "onView:pirate.sessions",
    "onView:pirate.chat"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Pi-rate Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/pirate-neon-color-theme.json"
      },
      {
        "label": "Pi-rate Daylight",
        "uiTheme": "vs",
        "path": "./themes/pirate-daylight-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pirate",
          "title": "Pi-rate",
          "icon": "media/pirate.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pirate-secondary",
          "title": "Pi-rate",
          "icon": "media/pirate.svg"
        }
      ]
    },
    "views": {
      "pirate": [
        {
          "type": "tree",
          "id": "pirate.sessions",
          "name": "Sessions",
          "icon": "$(history)",
          "contextualTitle": "Pi-rate"
        }
      ],
      "pirate-secondary": [
        {
          "type": "webview",
          "id": "pirate.chat",
          "name": "Pi-rate",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Pi-rate"
        }
      ]
    },
    "commands": [
      {
        "command": "pirate.openWalkthrough",
        "title": "Pi-rate: Open Getting Started",
        "icon": "$(mortar-board)"
      },
      {
        "command": "pirate.chat.focus",
        "title": "Pi-rate: Focus Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pirate.refreshSessions",
        "title": "Pi-rate: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "pirate.newSession",
        "title": "Pi-rate: New Session",
        "icon": "$(plus)",
        "category": "Pi-rate"
      },
      {
        "command": "pirate.openSession",
        "title": "Pi-rate: Open Session",
        "icon": "$(comment-discussion)",
        "category": "Pi-rate"
      },
      {
        "command": "pirate.attachFile",
        "title": "Pi-rate: Attach File to Prompt",
        "icon": "$(file-add)",
        "category": "Pi-rate"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pirate.newSession",
          "group": "navigation@1",
          "when": "view == pirate.sessions"
        },
        {
          "command": "pirate.refreshSessions",
          "group": "navigation@2",
          "when": "view == pirate.sessions"
        }
      ],
      "view/item/context": [
        {
          "command": "pirate.openSession",
          "group": "inline@1",
          "when": "view == pirate.sessions && viewItem == pirateSession"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pirate.chat.focus",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ],
    "chatParticipants": [
      {
        "id": "pirate.pirate-vscode.agent",
        "name": "pirate",
        "fullName": "Pi-rate",
        "description": "The Pi-rate coding agent.",
        "isSticky": true,
        "sampleRequest": "Explain the architecture of this repository."
      }
    ],
    "chatSessions": [
      {
        "type": "pirate",
        "name": "pirate",
        "displayName": "Pi-rate",
        "description": "Sessions powered by the Pi-rate coding agent over ACP.",
        "when": "true"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "pirate",
        "displayName": "Pi-rate"
      }
    ],
    "walkthroughs": [
      {
        "id": "pirate.getstarted",
        "title": "Get Started with Pi-rate",
        "description": "Set up Pi-rate, open your chat, and learn the core coding workflows.",
        "steps": [
          {
            "id": "pirate.getstarted.configure",
            "title": "Point Pi-rate at your pirate binary",
            "description": "Pi-rate needs the path to the __`pirate` executable__ it should run in ACP mode. Set `pirate.command` if `pirate` is not already on your PATH. Only change this if the default does not find your binary.\n[Open Settings](command:workbench.action.openSettings?%22pirate.command%22)",
            "media": {
              "image": "media/walkthrough/configure.svg",
              "altText": "The pirate.command setting pointing at the pirate binary"
            },
            "completionEvents": [
              "onSettingChanged:pirate.command"
            ]
          },
          {
            "id": "pirate.getstarted.chat",
            "title": "Open the Pi-rate chat",
            "description": "Chat with the Pi-rate agent in a dedicated sidebar tab. Use the `cmd+alt+u` keybinding to focus it from anywhere.\n[Open the Pi-rate Chat](command:pirate.chat.focus)",
            "media": {
              "image": "media/walkthrough/chat.svg",
              "altText": "The Pi-rate chat tab with its prompt input"
            },
            "completionEvents": [
              "onView:pirate.chat"
            ]
          },
          {
            "id": "pirate.getstarted.session",
            "title": "Start a new session",
            "description": "Each conversation is a session, saved to your Pi-rate history so you can pick it up again later from the Sessions view in the Pi-rate activity bar.\n[Start a New Session](command:pirate.newSession)",
            "media": {
              "image": "media/walkthrough/session.svg",
              "altText": "A new session being added to the session list"
            },
            "completionEvents": [
              "onCommand:pirate.newSession"
            ]
          },
          {
            "id": "pirate.getstarted.attach",
            "title": "Attach a file to your prompt",
            "description": "Give the agent context without pasting code: attach files from your workspace to the prompt before sending it.\n[Attach a File](command:pirate.attachFile)",
            "media": {
              "image": "media/walkthrough/attach.svg",
              "altText": "A file being attached to the chat prompt"
            },
            "completionEvents": [
              "onCommand:pirate.attachFile"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Pi-rate",
      "properties": {
        "pirate.command": {
          "type": "string",
          "default": "pirate",
          "description": "Path to the Pi-rate executable."
        },
        "pirate.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "acp-server"
          ],
          "description": "Arguments passed to Pi-rate."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && node esbuild.js",
    "package": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && node esbuild.js --production",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "themes": "node scripts/themes.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@catppuccin/vscode": "^3.18.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.137.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "marked": "^15.0.7",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
